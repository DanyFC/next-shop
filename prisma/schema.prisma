// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum Gender {
  kid
  men
  unisex
  women
}

enum Role {
  admin
  user
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  Product Product[]
}

model Product {
  id          String   @id @default(uuid())
  description String
  gender      Gender
  inStock     Int
  price       Float    @default(0)
  sizes       Size[]
  slug        String   @unique
  tags        String[] @default([])
  title       String

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  ProductImage ProductImage[]
  ProductOrder ProductOrder[]

  @@index([gender])
}

model ProductImage {
  id  Int    @id @default(autoincrement())
  url String

  productId String

  product Product @relation(fields: [productId], references: [id])
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          Role      @default(user)
  image         String?

  address Address?
  Order   Order[]
}

model Country {
  id           String         @id
  name         String
  Address      Address[]
  AddressOrder AddressOrder[]
}

model Address {
  id              String  @id @default(uuid())
  names           String
  lastNames       String?
  address         String
  addressOptional String?
  postalCode      String
  city            String
  phone           String

  country   Country @relation(fields: [countryId], references: [id])
  countryId String

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Order {
  id              String   @id @default(uuid())
  subTotal        Float
  tax             Float
  total           Float
  productsInOrder Int
  isPaid          Boolean
  paidAt          DateTime?
  isSend          Boolean  @default(false)
  sendAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  ProductOrder ProductOrder[]
  AddressOrder AddressOrder?
}

model ProductOrder {
  id       String @id @default(uuid())
  quantity Int
  price    Float
  size     Size

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  product   Product @relation(fields: [productId], references: [id])
  productId String
}

model AddressOrder {
  id              String  @id @default(uuid())
  names           String
  lastNames       String?
  address         String
  addressOptional String?
  postalCode      String
  city            String
  phone           String

  country   Country @relation(fields: [CountryId], references: [id])
  CountryId String

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique
}
